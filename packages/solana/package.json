{
  "name": "@me2em/solana",
  "version": "1.1.0-rc.1",
  "description": "Solana adapter for the Me2eM payment layer: deterministic wallet trees, chain adapters, payment references, request URLs, payment verification/submission and the x402 PaymentSigner (SolanaX402Signer)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build-docs": "pnpm --filter \"@me2em/solana^...\" run build && typedoc",
    "test:coverage": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@me2em/crypto": "workspace:^",
    "@noble/curves": "^1.8.1",
    "@scure/base": "^2.4.0",
    "@solana-program/memo": "^0.16.0",
    "@solana-program/system": "^0.16.0",
    "@solana/keys": "^2.3.0",
    "@solana/kit": "^8.6.0"
  },
  "peerDependencies": {
    "@me2em/core": ">=1.0.0-rc.8 <2.0.0-0"
  },
  "devDependencies": {
    "@me2em/core": "workspace:^",
    "@me2em/x402": "workspace:^",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
