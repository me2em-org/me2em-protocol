{
  "name": "@me2em/solana",
  "version": "1.0.0-rc.1",
  "description": "Solana adapter for the Me2eM payment layer: deterministic wallet trees, chain adapters, payment references and request URLs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build-docs": "typedoc",
    "test:coverage": "vitest run --coverage"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@me2em/crypto": "workspace:^",
    "@scure/base": "^2.4.0"
  },
  "peerDependencies": {
    "@me2em/core": ">=1.0.0-rc.3 <2.0.0-0"
  },
  "devDependencies": {
    "@me2em/core": "workspace:^",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
