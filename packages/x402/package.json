{
  "name": "@me2em/x402",
  "version": "1.0.0-rc.1",
  "description": "x402 v2 payment transport for the Me2eM protocol: base64 header codec, payment-aware fetch client, server helpers and facilitator clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./b402": {
      "types": "./dist/b402.d.ts",
      "import": "./dist/b402.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build-docs": "pnpm --filter \"@me2em/x402^...\" run build && typedoc",
    "test:coverage": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@me2em/core": ">=1.0.0-rc.8 <2.0.0-0"
  },
  "devDependencies": {
    "@me2em/core": "workspace:^",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
