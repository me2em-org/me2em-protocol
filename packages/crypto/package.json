{
  "name": "@me2em/crypto",
  "version": "1.1.0-rc.2",
  "description": "Cryptographic mechanisms for the Me2eM protocol: E2EE channels, X3DH, purpose-based key derivation, envelopes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build-docs": "pnpm --filter \"@me2em/crypto^...\" run build && typedoc",
    "test:coverage": "vitest run --coverage"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@me2em/core": "workspace:^",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^1.6.0",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
