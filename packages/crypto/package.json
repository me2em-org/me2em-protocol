{
  "name": "@me2em/crypto",
  "version": "0.1.0-alpha.1",
  "description": "Cryptographic mechanisms for the Me2em protocol: E2EE channels, X3DH, purpose-based key derivation, envelopes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build-docs": "typedoc"
  },
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@me2em/core": "workspace:*",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^2.2.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.26.11",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
